# LiveEcho (现场回响) — Environment Configuration Example
# Copy to .env (never commit .env to Git). All external API keys are optional;
# core tracking, ShowStart radar, Smart Paste, .ics export, and Browser alerts require zero keys.

# Server bind & port (defaults strictly to 127.0.0.1:8788 locally)
CONCERT_TRACKER_HOST=127.0.0.1
CONCERT_TRACKER_PORT=8788

# Required when CONCERT_TRACKER_ENV=production (>= 32 random hex/base64 characters)
# Generate via: python3 -c "import secrets; print(secrets.token_hex(32))"
CONCERT_TRACKER_ENV=development
CONCERT_TRACKER_SECRET_KEY=

# Optional Turso (libSQL) Cloud SQLite for $0 persistent hosting on Render Free Tier
# Leave blank locally to use local SQLite (./data/concert_tracker.db).
# Example URL: libsql://liveecho-yourname.aws-ap-southeast-1.turso.io
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Optional Bearer secret (>= 32 chars) if triggering POST /api/cron/tick via external HTTP scheduler
CRON_SECRET=

# Set to 1 when deployed behind an HTTPS reverse proxy (Render, Railway, Cloudflare, Nginx)
CONCERT_TRACKER_TLS=0

# Optional public origin URL for strict Same-Origin CSRF validation (e.g. https://liveecho.onrender.com)
PUBLIC_ORIGIN=

# Optional custom SQLite & sanitized upload storage directory
CONCERT_TRACKER_DATA_DIR=./data
